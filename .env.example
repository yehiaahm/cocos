# Optional: overrides `url` in src/config/site.ts at build time (no trailing slash).
# On Cloudflare Pages, add it under Settings → Variables and Secrets (as a build variable).
VITE_SITE_URL=https://www.example.com

# Node server (Railway) — set these in the Railway dashboard, not here. See README → Deploying and docs/BACKUP_RESTORE.md
# DATABASE_URL=mysql://user:pass@host:3306/dbname   (Railway: ${{MySQL.MYSQL_URL}}; MYSQL_URL is also accepted)
# REQUIRE_PERSISTENT_STORAGE=1   refuse to start / fail the health check when no Volume is attached (add AFTER the volume exists)
# BACKUP_INTERVAL_HOURS=24       BACKUP_KEEP=14
# ALLOW_FRESH_DATABASE=1         one-off: start from an empty database although dumps of an older one exist (normally you restore instead)
# TEST_MYSQL_URL=mysql://root:cocos-test-only@127.0.0.1:3317   used by `npm test`
