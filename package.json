{
  "name": "cocos-art",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Coco's Art — handmade home decor e-commerce site",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "predev": "npm run images",
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "prebuild": "npm run images",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
