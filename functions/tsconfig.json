{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "./**/*.ts",
    "../server/**/*.ts",
    "../src/lib/phone.ts",
    "../src/lib/api-types.ts"
  ],
  "exclude": [
    "../server/**/*.test.ts",
    "../server/node/**"
  ]
}
